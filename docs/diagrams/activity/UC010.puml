@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 8
skinparam padding 8
skinparam nodesep 35
skinparam ranksep 45
skinparam ArrowColor #43556B
skinparam backgroundColor white
skinparam classAttributeIconSize 0
skinparam linetype polyline
title UC010 AI Sinh biên bản họp
start
:Nhập, chọn hoặc tải ghi chú họp;
if (Quyền và dữ liệu hợp lệ?) then (không)
 :Thông báo lỗi, không ghi dở dang;
 stop
else (có)
 :Kiểm quyền và trích xuất nguồn/passage;
 :Gọi AI, kiểm schema và bao phủ từng đoạn;
 :Hiển thị draft, tham chiếu và cảnh báo;
 if (Nguồn/kết quả còn cảnh báo?) then (có)
  :Để cần xác minh, người dùng đối chiếu nguồn;
 else (không)
  :Hiển thị draft hợp lệ;
 endif
 :PM chủ động sửa/xác nhận đúng version;
 :Backend kiểm quyền/version rồi lưu chính thức;
endif
stop

@enduml
