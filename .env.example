# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=mat_khau_mysql_cua_ban
DB_NAME=ai_project_management

# Flask App Secret Key
# Generate a private, stable key before running multiple server processes.
SECRET_KEY=

# Primary Gemini API; keep the key on the backend only.
AI_PROVIDER=gemini
AI_CONFIG_SOURCE=env_file
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MEETING_MODEL=gemini-3.6-flash
# Optional legacy DeepSeek settings, used only when AI_PROVIDER=deepseek.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://discovery-api.intern-ai.org.cn/v1
OPENAI_MODEL=deepseek-v4.1-flash-1017
OPENAI_MEETING_MODEL=deepseek-v4.1-flash-1017
AI_TIMEOUT_SECONDS=60
AI_MEETING_TIMEOUT_SECONDS=60
AI_TOTAL_TIMEOUT_SECONDS=180
# Keep API first, switch to the local model/domain brain on failure.
AI_LOCAL_FALLBACK_ENABLED=true
AI_PRIMARY_BUDGET_SECONDS=30
LOCAL_AI_MODEL_ENABLED=true
LOCAL_AI_AUTOSTART=true
LOCAL_AI_PORT=18081
LOCAL_AI_TIMEOUT_SECONDS=45
# To share this local server on a trusted LAN, set HOST=0.0.0.0.

# Email Notification Configuration (FR-17 / BR-09)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@aiprojectmanager.local
SMTP_ENABLED=false
DEADLINE_WORKER_ENABLED=true
DEADLINE_SCAN_SECONDS=60
OVERDUE_REPEAT_HOURS=24
OVERDUE_RETRY_SECONDS=300

# Enable secure cookies only when the application is served over HTTPS.
SESSION_COOKIE_SECURE=false
FLASK_DEBUG=false
HOST=127.0.0.1
